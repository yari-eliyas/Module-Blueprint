<?php

namespace App\Modules\{{moduleName}}\Controller;

use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controller as BaseController;

class {{moduleName}}Controller extends BaseController
{
    public function index(): JsonResponse
    {
        return response()->json([
            'module' => '{{moduleName}}',
            'message' => 'Module is working.',
        ]);
    }

    public function show(int $id): JsonResponse
    {
        return response()->json(['id' => $id]);
    }

    public function store(Request $request): JsonResponse
    {
        return response()->json(['data' => $request->validated() ?? $request->all()]);
    }

    public function update(Request $request, int $id): JsonResponse
    {
        return response()->json([
            'id' => $id,
            'data' => $request->validated() ?? $request->all(),
        ]);
    }

    public function destroy(int $id): JsonResponse
    {
        return response()->json(['id' => $id]);
    }
}
